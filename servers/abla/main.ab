import github("AndreBaltazar8/abla-web")
import "abla/http/event"
import "abla/json"
import "abla/memory"
import "abla/process/arguments"

fun plaintext(context: WebContext): HttpResponse =
    httpText("hello, world!\n")

fun handlePlaintext(request: HttpRequest): HttpResponse =
    webNoEscapeRoute(request, "GET", "/plaintext", plaintext)

fun parameters(context: WebContext): HttpResponse {
    val account = context.parameter("account")
    val item = context.parameter("item")
    val filter = context.parameter("filter")
    httpText("$account:$item:$filter\n")
}

fun handleParameters(request: HttpRequest): HttpResponse =
    webNoEscapeRoute(
        request,
        "GET",
        "/accounts/:account/items/:item",
        parameters
    )

fun routeTail(request: HttpRequest): HttpResponse {
    val account = request.parameter("account")
    val order = request.parameter("order")
    val expand = request.parameter("expand")
    httpText("$account:$order:$expand\n")
}

fun routeTailDecoy(request: HttpRequest): HttpResponse = httpText("decoy\n")

fun parameters16(context: WebContext): HttpResponse {
    val p0 = context.request.parameterValues[0]
    val p1 = context.request.parameterValues[1]
    val p2 = context.request.parameterValues[2]
    val p3 = context.request.parameterValues[3]
    val p4 = context.request.parameterValues[4]
    val p5 = context.request.parameterValues[5]
    val p6 = context.request.parameterValues[6]
    val p7 = context.request.parameterValues[7]
    var q0 = ""
    var q1 = ""
    var q2 = ""
    var q3 = ""
    var q4 = ""
    var q5 = ""
    var q6 = ""
    var q7 = ""
    var queryIndex = 0
    var fieldBegin = 0
    while (queryIndex < 8 && fieldBegin <= context.request.query.size) {
        var fieldEnd = textFindByte(
            context.request.query,
            38,
            fieldBegin,
            context.request.query.size
        )
        if (fieldEnd < 0) fieldEnd = context.request.query.size
        val equals = textFindByte(
            context.request.query,
            61,
            fieldBegin,
            fieldEnd
        )
        val value = if (equals >= fieldBegin) {
            context.request.query.slice(equals + 1, fieldEnd)
        } else ""
        if (queryIndex == 0) q0 = value
        else if (queryIndex == 1) q1 = value
        else if (queryIndex == 2) q2 = value
        else if (queryIndex == 3) q3 = value
        else if (queryIndex == 4) q4 = value
        else if (queryIndex == 5) q5 = value
        else if (queryIndex == 6) q6 = value
        else q7 = value
        queryIndex = queryIndex + 1
        fieldBegin = fieldEnd + 1
    }
    httpText("$p0:$p1:$p2:$p3:$p4:$p5:$p6:$p7:$q0:$q1:$q2:$q3:$q4:$q5:$q6:$q7\n")
}

fun handleParameters16(request: HttpRequest): HttpResponse =
    webNoEscapeRoute(
        request,
        "GET",
        "/p/:p0/s1/:p1/s2/:p2/s3/:p3/s4/:p4/s5/:p5/s6/:p6/s7/:p7",
        parameters16
    )

fun headers32(context: WebContext): HttpResponse {
    val h0 = context.header("x-bench-00")
    val h7 = context.header("x-bench-07")
    val h15 = context.header("x-bench-15")
    val h23 = context.header("x-bench-23")
    val h31 = context.header("x-bench-31")
    httpText("$h0:$h7:$h15:$h23:$h31\n")
}

fun handleHeaders32(request: HttpRequest): HttpResponse =
    webNoEscapeRoute(request, "GET", "/headers-32", headers32)

fun fanoutTarget(request: HttpRequest): HttpResponse =
    httpText("fanout-target\n")

fun query32Named(context: WebContext): HttpResponse {
    val q0 = context.request.queryParameter("field-00")
    val q7 = context.request.queryParameter("field-07")
    val q13 = context.request.queryParameter("field-13")
    val q19 = context.request.queryParameter("field-19")
    val q25 = context.request.queryParameter("field-25")
    val q27 = context.request.queryParameter("field-27")
    val q29 = context.request.queryParameter("field-29")
    val q31 = context.request.queryParameter("field-31")
    httpText("$q0:$q7:$q13:$q19:$q25:$q27:$q29:$q31\n")
}

fun handleQuery32Named(request: HttpRequest): HttpResponse =
    webNoEscapeRoute(request, "GET", "/query-32", query32Named)

fun jsonNested(context: WebContext): HttpResponse {
    val reader = jsonObjectReader(context.request.body)
    reader.nextExpectedRaw("request_id")
    val requestId = reader.readString()
    reader.nextExpectedRaw("user")
    val user = reader.readObject()
    user.nextExpectedRaw("id")
    user.readInteger()
    user.nextExpectedRaw("name")
    val userName = user.readString()
    user.nextExpectedRaw("roles")
    val roles = user.readArray()
    var primaryRole = ""
    if (roles.next()) primaryRole = roles.readString()
    while (roles.next()) roles.skip()
    if (!roles.finishNested()) return httpJson("null", 400)
    if (!user.finishNested()) return httpJson("null", 400)
    reader.nextExpectedRaw("items")
    val items = reader.readArray()
    var itemCount = 0
    var total = 0
    while (items.next()) {
        val item = items.readObject()
        item.nextExpectedRaw("sku")
        item.readString()
        item.nextExpectedRaw("qty")
        val quantity = item.readInteger()
        item.nextExpectedRaw("price")
        val price = item.readInteger()
        if (!item.finishNested()) return httpJson("null", 400)
        total = total + quantity * price
        itemCount = itemCount + 1
    }
    if (!items.finishNested()) return httpJson("null", 400)
    reader.nextExpectedRaw("active")
    val active = reader.readBoolean()
    reader.nextExpectedRaw("note")
    reader.readString()
    if (!reader.finish()) return httpJson("null", 400)
    val encoder = jsonEncoder()
    encoder.beginObject()
    encoder.encodedObjectKey(#jsonEncodeObjectKey("active"))
    encoder.boolean(active)
    encoder.encodedObjectKey(#jsonEncodeObjectKey("item_count"))
    encoder.integer(itemCount)
    encoder.encodedObjectKey(#jsonEncodeObjectKey("primary_role"))
    encoder.string(primaryRole)
    encoder.encodedObjectKey(#jsonEncodeObjectKey("request_id"))
    encoder.string(requestId)
    encoder.encodedObjectKey(#jsonEncodeObjectKey("total"))
    encoder.integer(total)
    encoder.encodedObjectKey(#jsonEncodeObjectKey("user"))
    encoder.string(userName)
    encoder.endObject()
    httpJson(encoder.finish())
}

fun handleJsonNested(request: HttpRequest): HttpResponse =
    webNoEscapeRoute(request, "POST", "/json-nested", jsonNested)

fun echoBody(context: WebContext): HttpResponse = HttpResponse(
    200,
    [HttpHeader("Content-Type", "application/octet-stream")],
    context.request.body
)

fun handleBody(request: HttpRequest): HttpResponse =
    webNoEscapeRoute(request, "POST", "/body", echoBody)

fun benchmarkAuthenticate(
    token: string
): WebAuthResult = WebAuthResult(
    token == "benchmark-token",
    "user-7",
    "invalid benchmark token",
    jsonObject(
        ["id", "name", "tier"],
        [jsonString("user-7"), jsonString("Andre"), jsonString("gold")]
    )
)

fun benchmarkContextResponse(
    context: WebContext
): HttpResponse {
    val principal = context.local("principal")
    val user = context.jsonLocal("user")
    val name = user.getString("name")
    val tier = user.getString("tier")
    httpText("$principal:$name:$tier\n")
}

fun benchmarkPort(): int {
    var port = 18080
    if (processArgumentCount() > 0) {
        val parsed = httpDecimalLength(processArgument(0), 65535)
        if (parsed > 0) port = parsed
    }
    port
}

fun benchmarkReusePort(): bool =
    processArgumentCount() > 2 && processArgument(2) == "--reuse-port"

fun benchmarkScenario(): string =
    if (processArgumentCount() > 1) processArgument(1) else "plaintext"

fun main: int {
    // Long-running services explicitly select Abla's managed collector. Pure
    // short-lived programs that never touch this API omit the collector.
    memorySetLimit(memoryLimit())
    val scenario = benchmarkScenario()
    val maximumBody = if (scenario == "body-16k") 65536 else 1024
    val options = HttpEventServerOptions(
        4096,
        16384,
        maximumBody,
        1048576,
        1000000,
        30000,
        4096,
        5000
    )
    if (scenario == "route-tail-128") {
        val router = httpRouter()
        var routeIndex = 0
        while (routeIndex < 128) {
            router.get("/ridiculous/decoy-$routeIndex", routeTailDecoy)
            routeIndex = routeIndex + 1
        }
        router.get(
            "/ridiculous/:account/orders/:order",
            routeTail
        )
        val server = httpEventServerNoEscapeHandler(
            { request: HttpRequest -> router.dispatch(request) },
            ipv4Loopback(benchmarkPort()),
            options,
            benchmarkReusePort()
        )
        server.run()
    } else if (scenario == "route-fanout-1024") {
        val router = httpRouter()
        var routeIndex = 0
        while (routeIndex < 1024) {
            router.get("/fanout/decoy-$routeIndex", routeTailDecoy)
            routeIndex = routeIndex + 1
        }
        router.get("/fanout/target", fanoutTarget)
        val server = httpEventServerNoEscapeHandler(
            { request: HttpRequest -> router.dispatch(request) },
            ipv4Loopback(benchmarkPort()),
            options,
            benchmarkReusePort()
        )
        server.run()
    } else if (scenario == "parameters-16") {
        val server = httpEventServerNoEscapeHandler(
            handleParameters16,
            ipv4Loopback(benchmarkPort()),
            options,
            benchmarkReusePort()
        )
        server.run()
    } else if (scenario == "headers-32") {
        val server = httpEventServerNoEscapeHandler(
            handleHeaders32,
            ipv4Loopback(benchmarkPort()),
            options,
            benchmarkReusePort()
        )
        server.run()
    } else if (scenario == "query-32-named") {
        val server = httpEventServerNoEscapeHandler(
            handleQuery32Named,
            ipv4Loopback(benchmarkPort()),
            options,
            benchmarkReusePort()
        )
        server.run()
    } else if (scenario == "json-nested") {
        val server = httpEventServerNoEscapeHandler(
            handleJsonNested,
            ipv4Loopback(benchmarkPort()),
            options,
            benchmarkReusePort()
        )
        server.run()
    } else if (scenario == "context") {
        val app = webScopedApp()
        app.use(webScopedBearerAuth(benchmarkAuthenticate))
        app.get("/context", benchmarkContextResponse)
        val server = httpEventServerNoEscapeHandler(
            { request: HttpRequest -> webScopedDispatch(app, request) },
            ipv4Loopback(benchmarkPort()),
            options,
            benchmarkReusePort()
        )
        server.run()
    } else if (scenario == "parameters") {
        val server = httpEventServerNoEscapeHandler(
            handleParameters,
            ipv4Loopback(benchmarkPort()),
            options,
            benchmarkReusePort()
        )
        server.run()
    } else if (scenario == "body-16k") {
        val server = httpEventServerNoEscapeHandler(
            handleBody,
            ipv4Loopback(benchmarkPort()),
            options,
            benchmarkReusePort()
        )
        server.run()
    } else {
        val server = httpEventServerNoEscapeHandler(
            handlePlaintext,
            ipv4Loopback(benchmarkPort()),
            options,
            benchmarkReusePort()
        )
        server.run()
    }
}
